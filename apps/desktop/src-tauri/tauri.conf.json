{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SixBox",
  "version": "0.1.0",
  "identifier": "cn.sixlab.box",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SixBox", "width": 1040, "height": 740, "minWidth": 760, "minHeight": 560 }],
    "withGlobalTauri": false,
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "publisher": "SixLab",
    "copyright": "Copyright © 2026 SixLab（六楼实验室）",
    "license": "AGPL-3.0-only",
    "licenseFile": "../../../LICENSE",
    "category": "Utility",
    "shortDescription": "常用工具，一盒搞定。",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/node"],
    "resources": {
      "resources/": "runtime/",
      "../../../LICENSE": "LICENSE",
      "../../../COPYRIGHT": "COPYRIGHT",
      "../../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": { "minimumSystemVersion": "13.5", "signingIdentity": "-" }
  }
}
